# LiveKit Cloud credentials
# Get these from https://cloud.livekit.io/ or run: lk app env -w
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# Google AI API key for Gemini
GOOGLE_API_KEY=your_google_api_key

# Deepgram API Key for Speech-to-Text and Text-to-Speech
DEEPGRAM_API_KEY=your_deepgram_api_key

# OpenAI API key (fallback LLM if Google is unavailable)
OPENAI_API_KEY=your_openai_api_key

# Appointment webhook endpoints
APPOINTMENT_WEBHOOK_URL=https://your-webhook-endpoint.com/create_appointment
RESCHEDULE_WEBHOOK_URL=
CANCEL_WEBHOOK_URL=
LOOKUP_WEBHOOK_URL=
AVAILABILITY_WEBHOOK_URL=

# Phone number for human escalation (SIP URI format)
CLINIC_TRANSFER_NUMBER=+1XXXXXXXXXX

# Human-readable clinic phone for fallback messages
CLINIC_PHONE_DISPLAY=(XXX) XXX-XXXX
